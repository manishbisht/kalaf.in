# Env vars read by the app via src/env.ts.
# All client-exposed vars must be prefixed VITE_.
# Leave a value blank to disable the feature in this environment.

# Microsoft Clarity — get the project ID from https://clarity.microsoft.com/
VITE_CLARITY_PROJECT_ID=

# Build metadata — set by CI (.github/workflows/deploy.yml). Blank locally.
VITE_BUILD_VERSION=
VITE_COMMIT_SHA=
